# --- Supabase ---
# Project URL and keys from Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-side only, NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Access control ---
# Only this Google account is allowed to use the app
ALLOWED_EMAIL=you@gmail.com

# --- Tebex ---
# Webhook secret shown in Tebex Creator Panel > Webhooks when you add the endpoint
TEBEX_WEBHOOK_SECRET=your-tebex-webhook-secret

# --- Display ---
NEXT_PUBLIC_CURRENCY=USD
# Base URL of the deployed app (used to show the webhook URL on the Settings page)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Recurring expenses cron ---
# Vercel Cron sends this as a Bearer token to /api/recurring/post.
# Set the same value in the Vercel project env vars.
CRON_SECRET=
